---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate, seriesSlug } from '../../lib/utils';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allTags = [...new Set(posts.flatMap(p => p.data.tags))].sort();
---

<BaseLayout title="블로그">
  <div class="page-fade">
    <div class="page-wrap blog-list-page">
      <div class="section-header" style="margin-bottom: 24px;">
        <span class="section-title">전체 글 ({posts.length})</span>
        <button class="section-link" id="reset-filter" style="display:none;">필터 초기화</button>
      </div>

      <!-- Tag Filter -->
      <div class="tag-filter" id="tag-filter">
        {allTags.map(tag => (
          <button class="tag-chip-btn" data-tag={tag}>{tag}</button>
        ))}
      </div>

      <!-- Post Cards -->
      <div class="post-grid" id="post-grid">
        {posts.map(post => (
          <a
            href={`/blog/${post.slug}`}
            class="post-card"
            data-tags={post.data.tags.join(',')}
          >
            {post.data.series && (
              <span class="card-series">{post.data.series}</span>
            )}
            <div class="card-title">{post.data.title}</div>
            <p class="card-desc">{post.data.description}</p>
            <div class="card-footer">
              <div class="card-tags">
                {post.data.tags.slice(0, 4).map(t => (
                  <span class="tag-chip">{t}</span>
                ))}
              </div>
              <span class="card-date">{formatDate(post.data.pubDate)}</span>
            </div>
          </a>
        ))}
      </div>

      <p id="no-results" style="display:none; color: var(--text3); font-size: 14px; padding: 40px 0; text-align: center;">
        해당 태그의 글이 없습니다.
      </p>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var activeTags = [];
    var chips = document.querySelectorAll('.tag-chip-btn');
    var cards = document.querySelectorAll('.post-card');
    var resetBtn = document.getElementById('reset-filter');
    var noResults = document.getElementById('no-results');

    function filter() {
      var visible = 0;
      cards.forEach(function (card) {
        var tags = (card.dataset.tags || '').split(',');
        var show = activeTags.length === 0 || activeTags.every(function (t) { return tags.includes(t); });
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      noResults.style.display = visible === 0 ? 'block' : 'none';
      resetBtn.style.display = activeTags.length > 0 ? '' : 'none';
    }

    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        var tag = chip.dataset.tag;
        var idx = activeTags.indexOf(tag);
        if (idx === -1) { activeTags.push(tag); chip.classList.add('active'); }
        else { activeTags.splice(idx, 1); chip.classList.remove('active'); }
        filter();
      });
    });

    resetBtn?.addEventListener('click', function () {
      activeTags = [];
      chips.forEach(function (c) { c.classList.remove('active'); });
      filter();
    });
  })();
</script>
