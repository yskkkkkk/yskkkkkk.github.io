---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: project,
  }));
}

const project = Astro.props;
const { Content } = await project.render();
---

<BaseLayout title={project.data.title} description={project.data.description}>
  <article>
    {project.data.heroImage && (
      <img class="hero" src={project.data.heroImage} alt={project.data.title} />
    )}
    <header>
      <div class="meta">
        <time datetime={project.data.pubDate.toISOString()}>
          {project.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </div>
      <h1>{project.data.title}</h1>
      <p class="description">{project.data.description}</p>
      <div class="actions">
        {project.data.repoUrl && (
          <a href={project.data.repoUrl} target="_blank" rel="noopener" class="btn-secondary">
            View Source
          </a>
        )}
        {project.data.liveUrl && (
          <a href={project.data.liveUrl} target="_blank" rel="noopener" class="btn-primary">
            Live Demo
          </a>
        )}
      </div>
      {project.data.tags.length > 0 && (
        <div class="tags">
          {project.data.tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
      )}
    </header>
    <hr />
    <div class="prose">
      <Content />
    </div>
  </article>
  <a class="back" href="/projects">&larr; All projects</a>
</BaseLayout>

<style>
  .hero {
    width: 100%;
    border-radius: var(--radius);
    margin-bottom: 2rem;
    border: 1px solid var(--color-border);
  }

  header { margin-bottom: 1.5rem; }

  .meta {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
  }

  h1 { margin-bottom: 0.5rem; }

  .description {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    margin-bottom: 1rem;
  }

  .actions {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .btn-primary, .btn-secondary {
    display: inline-block;
    padding: 0.45rem 1rem;
    border-radius: var(--radius);
    font-size: 0.875rem;
    font-weight: 600;
    transition: opacity 0.15s;
  }

  .btn-primary {
    background: var(--color-accent);
    color: #fff;
  }

  .btn-secondary {
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .btn-primary:hover, .btn-secondary:hover {
    opacity: 0.8;
    text-decoration: none;
  }

  .tags { display: flex; gap: 0.5rem; flex-wrap: wrap; }

  .back {
    display: inline-block;
    margin-top: 3rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .back:hover { color: var(--color-accent); text-decoration: none; }
</style>
