---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { readingTime, formatDate, seriesSlug } from '../lib/utils';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const recentPosts = allPosts.slice(0, 5);

// Build series map
const seriesMap = new Map<string, {
  posts: typeof allPosts;
  coverImage?: string;
  minDate: Date;
  maxDate: Date;
}>();

for (const post of allPosts) {
  if (!post.data.series) continue;
  const name = post.data.series;
  if (!seriesMap.has(name)) {
    seriesMap.set(name, { posts: [], minDate: post.data.pubDate, maxDate: post.data.pubDate });
  }
  const s = seriesMap.get(name)!;
  s.posts.push(post);
  if (post.data.pubDate < s.minDate) s.minDate = post.data.pubDate;
  if (post.data.pubDate > s.maxDate) s.maxDate = post.data.pubDate;
  if (!s.coverImage && post.data.heroImage) s.coverImage = post.data.heroImage;
}

function monthRange(min: Date, max: Date) {
  const fmt = (d: Date) => d.toLocaleDateString('ko-KR', { year: 'numeric', month: 'short' });
  if (fmt(min) === fmt(max)) return fmt(min);
  return `${fmt(min)} ~ ${fmt(max)}`;
}
---

<BaseLayout>
  <div class="page-fade">
    <div class="page-wrap">

      <!-- Hero -->
      <div class="hero-v11">
        <div class="hero-v11-eyebrow">Backend Engineer</div>
        <h1 class="hero-v11-title">삽질과 배움을<br/>솔직하게 기록합니다.</h1>
        <p class="hero-v11-sub">Java · Redis · 분산 시스템. 운영에서만 보이는 것들을 씁니다.</p>
      </div>

      <!-- Recent Posts -->
      <div class="numbered-posts">
        <div class="section-header">
          <span class="section-title">최신 글</span>
          <a href="/blog" class="section-link">모두 보기 →</a>
        </div>
        {recentPosts.map((post) => (
          <a href={`/blog/${post.slug}`} class="numbered-post">
            <div class="post-info">
              <span class="post-title">{post.data.title}</span>
              <div class="post-meta-row">
                {post.data.series && (
                  <>
                    <span class="post-series">{post.data.series}</span>
                    <span class="meta-dot">·</span>
                  </>
                )}
                <div class="post-tags-inline">
                  {post.data.tags.slice(0, 3).map(t => (
                    <span class="tag-inline">{t}</span>
                  ))}
                </div>
              </div>
            </div>
            <div class="post-right">
              <span class="post-date">{formatDate(post.data.pubDate)}</span>
              <span class="post-readtime">{readingTime(post.body)}분 읽기</span>
            </div>
          </a>
        ))}
      </div>

      <!-- Series -->
      {seriesMap.size > 0 && (
        <div class="series-section">
          <div class="section-header">
            <span class="section-title">아티클 시리즈</span>
          </div>
          <div class="series-row">
            {[...seriesMap.entries()].map(([name, s]) => (
              <a href={`/series/${seriesSlug(name)}`} class="series-card">
                <div class="series-cover">
                  {s.coverImage
                    ? <img src={s.coverImage} alt={name} />
                    : (
                      <>
                        <svg class="series-cover-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                          <path d="M4 19.5A2.5 2.5 0 016.5 17H20M4 19.5A2.5 2.5 0 014 17V5a2 2 0 012-2h12a2 2 0 012 2v12"/>
                        </svg>
                        <span class="series-cover-label">SERIES</span>
                      </>
                    )
                  }
                </div>
                <div class="series-body">
                  <div class="series-name">{name}</div>
                  <p class="series-desc">{s.posts[s.posts.length - 1]?.data.description ?? ''}</p>
                  <div class="series-footer">
                    <span class="series-count">{s.posts.length}편</span>
                    <span class="series-range">{monthRange(s.minDate, s.maxDate)}</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

    </div>
  </div>
</BaseLayout>
