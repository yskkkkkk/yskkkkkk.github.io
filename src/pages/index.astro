---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION } from '../consts';

// Format dynamic year-month helper (e.g. 2025.08)
const formatYearMonth = (date: Date) => {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, '0');
  return `${y}.${m}`;
};

// Format full date helper (e.g. 2025.09.24)
const formatDate = (date: Date) => {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, '0');
  const d = String(date.getDate()).padStart(2, '0');
  return `${y}.${m}.${d}`;
};

// Reading time calculator based on mixed Korean/English word count
const calculateReadingTime = (body: string) => {
  const cleanText = body.trim().replace(/[#*`_\[\]()\-]/g, ''); // Strip markdown symbols
  const words = cleanText.split(/\s+/).length;
  return Math.ceil(words / 180) || 1; // 180 wpm for mixed technical Korean/English
};

// Fetch blog posts
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = sortedPosts.slice(0, 5);

// Series Metadata mapping
const SERIES_METADATA: Record<string, { slug: string; description: string }> = {
  'Redis 프로젝트 회고': {
    slug: 'redis-project',
    description: '실제 대규모 서비스에 Redis 캐시를 도입하면서 겪은 기술적 문제들과 해결 과정. 분산 캐시 동기화, 동시성 이슈, 대규모 장애 대응까지.'
  }
};

// Dynamically compute series count and ranges
const seriesMap = new Map<string, { name: string; slug: string; description: string; count: number; minDate: Date; maxDate: Date }>();

allPosts.forEach(post => {
  const seriesName = post.data.series;
  if (!seriesName) return;

  const meta = SERIES_METADATA[seriesName] || {
    slug: seriesName.toLowerCase().replace(/[^\w가-힣\s]/g, '').replace(/\s+/g, '-'),
    description: '시리즈 아티클 모음입니다.'
  };

  const postDate = new Date(post.data.pubDate);

  if (!seriesMap.has(seriesName)) {
    seriesMap.set(seriesName, {
      name: seriesName,
      slug: meta.slug,
      description: meta.description,
      count: 1,
      minDate: postDate,
      maxDate: postDate
    });
  } else {
    const existing = seriesMap.get(seriesName)!;
    existing.count += 1;
    
    if (postDate < existing.minDate) {
      existing.minDate = postDate;
    }
    if (postDate > existing.maxDate) {
      existing.maxDate = postDate;
    }
  }
});

const seriesList = Array.from(seriesMap.values()).map(s => ({
  name: s.name,
  slug: s.slug,
  description: s.description,
  count: s.count,
  rangeLabel: `${formatYearMonth(s.minDate)} – ${formatYearMonth(s.maxDate)}`
}));
---

<BaseLayout description={SITE_DESCRIPTION}>
  <div class="page-wrap">
    <!-- Hero v1.1 Section -->
    <section class="hero-v11">
      <div class="hero-v11-eyebrow">Backend Engineer</div>
      <h1 class="hero-v11-title">삽질과 배움을<br/>솔직하게 기록합니다.</h1>
      <p class="hero-v11-sub">Java · Redis · 분산 시스템. 운영에서만 보이는 것들을 씁니다.</p>
    </section>

    <!-- Recent Posts Section (최신 글) -->
    {recentPosts.length > 0 && (
      <section class="numbered-posts">
        <div class="section-header">
          <h2 class="section-title">최신 글</h2>
          <a href="/blog" class="section-link">모두 보기 →</a>
        </div>
        
        <div style="display: flex; flex-direction: column;">
          {recentPosts.map((post, index) => {
            const readingTime = calculateReadingTime(post.body || '');
            return (
              <a href={`/blog/${post.slug}`} class="numbered-post">
                <span class="post-num">{String(index + 1).padStart(2, '0')}</span>
                <div class="post-info">
                  <span class="post-title">{post.data.title}</span>
                  <div class="post-meta-row">
                    {post.data.series && <span class="post-series">{post.data.series}</span>}
                    {post.data.series && <span class="meta-dot">·</span>}
                    <div class="post-tags-inline">
                      {post.data.tags.slice(0, 3).map(tag => (
                        <span class="tag-inline">{tag}</span>
                      ))}
                    </div>
                  </div>
                </div>
                <div class="post-right">
                  <span class="post-date">{formatDate(post.data.pubDate)}</span>
                  <span class="post-readtime">{readingTime}분 읽기</span>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- Article Series Section (아티클 시리즈) -->
    {seriesList.length > 0 && (
      <section class="series-section">
        <div class="section-header">
          <h2 class="section-title">아티클 시리즈</h2>
        </div>
        <div class="series-row">
          {seriesList.map((series) => (
            <a href={`/series/${series.slug}`} class="series-card">
              <div class="series-cover">
                <div class="series-cover-icon">
                  <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                    <path d="M3 9h18M9 21V9"></path>
                  </svg>
                </div>
                <span class="series-cover-label">커버 이미지</span>
              </div>
              <div class="series-body">
                <h3 class="series-name">{series.name}</h3>
                <p class="series-desc">{series.description}</p>
                <div class="series-footer">
                  <span class="series-count">{series.count}편</span>
                  <span class="series-range">{series.rangeLabel}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
