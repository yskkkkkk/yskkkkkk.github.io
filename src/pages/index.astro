---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION } from '../consts';
import { seriesSlug, formatDate, readingTime, SERIES_META } from '../lib/utils';

const formatYearMonth = (date: Date) => {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, '0');
  return `${y}.${m}`;
};

const allPosts = await getCollection('blog', ({ data }) => !data.draft && !data.externalUrl);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = sortedPosts.slice(0, 5);

const allPostsForSeries = await getCollection('blog', ({ data }) => !data.draft && !!data.series);

const seriesMap = new Map<string, { name: string; slug: string; description: string; count: number; minDate: Date; maxDate: Date }>();

allPostsForSeries.forEach(post => {
  const seriesName = post.data.series;
  if (!seriesName) return;

  const postDate = new Date(post.data.pubDate);

  if (!seriesMap.has(seriesName)) {
    seriesMap.set(seriesName, {
      name: seriesName,
      slug: seriesSlug(seriesName),
      description: post.data.description ?? '',
      count: 1,
      minDate: postDate,
      maxDate: postDate
    });
  } else {
    const existing = seriesMap.get(seriesName)!;
    existing.count += 1;
    if (postDate < existing.minDate) existing.minDate = postDate;
    if (postDate > existing.maxDate) {
      existing.maxDate = postDate;
      existing.description = post.data.description ?? existing.description;
    }
  }
});

// 최신순 정렬 (maxDate 내림차순)
const seriesList = Array.from(seriesMap.values())
  .sort((a, b) => b.maxDate.valueOf() - a.maxDate.valueOf())
  .map(s => ({
    name: s.name,
    slug: s.slug,
    description: SERIES_META[s.name]?.description ?? s.description,
    count: s.count,
    rangeLabel: `${formatYearMonth(s.minDate)} – ${formatYearMonth(s.maxDate)}`
  }));
---

<BaseLayout description={SITE_DESCRIPTION}>
  <div class="page-fade">
  <div class="page-wrap">
    <section class="hero-v11">
      <div class="hero-v11-eyebrow">Backend Engineer</div>
      <h1 class="hero-v11-title">운영에서 마주친 것들을<br/>솔직하게 기록합니다.</h1>
      <p class="hero-v11-sub">Java · Redis · 분산 시스템. 그 과정에서 배운 것들을 씁니다.</p>
    </section>

    {recentPosts.length > 0 && (
      <section class="numbered-posts">
        <div class="section-header">
          <h2 class="section-title">최신 글</h2>
          <a href="/blog" class="section-link">모두 보기 →</a>
        </div>
        <div style="display: flex; flex-direction: column;">
          {recentPosts.map((post) => (
            <a href={`/blog/${post.slug}`} class="numbered-post">
              <div class="post-info">
                <span class="post-title">{post.data.title}</span>
                <div class="post-meta-row">
                  {post.data.series && <span class="post-series">{post.data.series}</span>}
                  {post.data.series && <span class="meta-dot">·</span>}
                  <div class="post-tags-inline">
                    {post.data.tags.slice(0, 3).map(tag => (
                      <span class="tag-inline">{tag}</span>
                    ))}
                  </div>
                </div>
              </div>
              <div class="post-right">
                <span class="post-date">{formatDate(post.data.pubDate)}</span>
                <span class="post-readtime">{readingTime(post.body)}분 읽기</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    {seriesList.length > 0 && (
      <section class="series-section">
        <div class="section-header">
          <h2 class="section-title">아티클 시리즈</h2>
          <a href="/series" class="section-link">모두 보기 →</a>
        </div>
        <div class="series-row">
          {seriesList.map((series) => (
            <a href={`/series/${series.slug}`} class="series-card">
              <div class="series-cover">

                {/* ── 피카밈 개발기 ── */}
                {series.name === '피카밈 개발기' && (
                  <>
                    <div style="position:absolute;inset:0;background:#0e0c10;"></div>
                    <div style="position:absolute;right:-30px;top:-30px;width:160px;height:160px;background:radial-gradient(circle,rgba(196,77,255,0.3) 0%,transparent 65%);pointer-events:none;"></div>
                    <div style="position:absolute;left:-20px;bottom:-30px;width:130px;height:130px;background:radial-gradient(circle,rgba(255,107,157,0.22) 0%,transparent 65%);pointer-events:none;"></div>
                    <div style="position:absolute;top:12px;left:14px;font-family:monospace;font-size:9px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,107,157,0.75);background:rgba(255,107,157,0.1);border:1px solid rgba(255,107,157,0.22);padding:3px 8px;border-radius:5px;">Pika-a-meme</div>
                    <div style="position:absolute;top:11px;right:12px;background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.1);border-radius:7px;padding:3px 7px;display:flex;align-items:center;gap:4px;">
                      <span style="font-size:9px;">❤️</span><span style="font-family:monospace;font-size:9px;font-weight:700;color:rgba(255,255,255,0.65);">3/5</span>
                    </div>
                    <div style="position:absolute;left:14px;top:32px;bottom:0;width:48%;display:flex;align-items:center;">
                      <div style="font-size:15px;font-weight:900;color:white;letter-spacing:-0.01em;white-space:nowrap;">PICK-A-<em style="color:#FF6B9D;font-style:italic;">MEME</em></div>
                    </div>
                    <div style="position:absolute;right:16px;top:0;bottom:0;display:flex;align-items:center;gap:6px;">
                      <div style="width:29px;height:40px;border-radius:7px;background:linear-gradient(135deg,#2d1b4e,#1a0d2e);display:flex;align-items:center;justify-content:center;font-size:15px;border:1px solid rgba(196,77,255,0.25);opacity:0.65;transform:translateY(5px);">🐶</div>
                      <div style="width:36px;height:50px;border-radius:9px;background:linear-gradient(135deg,#FF6B9D,#C44DFF);display:flex;align-items:center;justify-content:center;font-size:22px;box-shadow:0 6px 18px rgba(255,107,157,0.5);">🐱</div>
                      <div style="width:29px;height:40px;border-radius:7px;background:linear-gradient(135deg,#1a2d1a,#0d1f0d);display:flex;align-items:center;justify-content:center;font-size:15px;border:1px solid rgba(107,200,157,0.2);opacity:0.65;transform:translateY(5px);">🐻</div>
                    </div>
                  </>
                )}

                {/* ── Pet-Pass 개발기 ── */}
                {series.name === 'Pet-Pass 개발기' && (
                  <>
                    <div style="position:absolute;inset:0;background:linear-gradient(135deg,#f0e8d4 0%,#e8d5b7 100%);"></div>
                    <div style="position:absolute;inset:0;background-image:radial-gradient(circle,rgba(100,70,20,0.12) 1.2px,transparent 1.2px);background-size:16px 16px;pointer-events:none;"></div>
                    <div style="position:absolute;right:-5px;bottom:-14px;font-size:88px;opacity:0.1;transform:rotate(-12deg);pointer-events:none;user-select:none;">🐾</div>
                    <div style="position:absolute;top:0;left:0;right:0;height:32px;background:rgba(255,255,255,0.55);border-bottom:1px solid rgba(255,255,255,0.65);display:flex;align-items:center;padding:0 10px;gap:6px;">
                      <span style="font-size:12px;">🐾</span>
                      <span style="font-size:11px;font-weight:800;color:#5c4520;letter-spacing:0.01em;">Pet-Pass</span>
                      <div style="flex:1;height:16px;background:rgba(255,255,255,0.75);border-radius:8px;border:1px solid rgba(200,184,154,0.4);margin:0 6px;max-width:90px;"></div>
                      <div style="display:flex;gap:3px;">
                        <div style="width:7px;height:7px;border-radius:50%;background:#c8b89a;"></div>
                        <div style="width:7px;height:7px;border-radius:50%;background:#f0f0f0;border:1px solid #e0e0e0;"></div>
                        <div style="width:7px;height:7px;border-radius:50%;background:#24273a;"></div>
                      </div>
                    </div>
                    <div style="position:absolute;top:40px;left:8px;right:8px;background:rgba(255,255,255,0.72);border-radius:7px;padding:5px 9px;display:flex;align-items:center;gap:7px;border:1px solid rgba(255,255,255,0.85);">
                      <span style="font-size:11px;">☕</span>
                      <div style="flex:1;overflow:hidden;">
                        <div style="font-size:9px;font-weight:700;color:#3d2e0f;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">스타벅스 강남점</div>
                        <div style="font-size:8px;color:#8c7040;">카페 · 23m</div>
                      </div>
                      <span style="font-size:8px;background:#e8f5e9;color:#2e7d32;border-radius:4px;padding:1px 5px;font-weight:700;white-space:nowrap;">✓ 통과</span>
                    </div>
                    <div style="position:absolute;top:82px;left:8px;right:8px;background:rgba(255,255,255,0.55);border-radius:7px;padding:5px 9px;display:flex;align-items:center;gap:7px;border:1px solid rgba(255,255,255,0.7);">
                      <span style="font-size:11px;">🍽</span>
                      <div style="flex:1;overflow:hidden;">
                        <div style="font-size:9px;font-weight:700;color:#3d2e0f;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">브런치 카페 소풍</div>
                        <div style="font-size:8px;color:#8c7040;">일반음식점 · 87m</div>
                      </div>
                      <span style="font-size:8px;background:#e8f5e9;color:#2e7d32;border-radius:4px;padding:1px 5px;font-weight:700;white-space:nowrap;">✓</span>
                    </div>
                  </>
                )}

                {/* ── Redis 프로젝트 회고 ── */}
                {series.name === 'Redis 프로젝트 회고' && (
                  <>
                    <div style="position:absolute;inset:0;background:linear-gradient(135deg,#7f1d1d 0%,#b91c1c 55%,#dc2626 100%);"></div>
                    <div class="cv-pat" style="background-image:linear-gradient(rgba(255,255,255,0.06) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.06) 1px,transparent 1px);background-size:24px 24px;"></div>
                    <div class="cv-glyph">CACHE</div>
                    <div class="cv-label">Redis Project</div>
                  </>
                )}

                {/* ── 백기선 live-study (2020) ── */}
                {series.name === '백기선 live-study (2020)' && (
                  <>
                    <div style="position:absolute;inset:0;background:linear-gradient(135deg,#78350f 0%,#b45309 55%,#d97706 100%);"></div>
                    <div class="cv-pat" style="background-image:radial-gradient(circle,rgba(255,255,255,0.14) 1.4px,transparent 1.4px);background-size:22px 22px;"></div>
                    <div class="cv-glyph">Java</div>
                    <div class="cv-label">Java Live-Study</div>
                  </>
                )}

              </div>
              <div class="series-body">
                <h3 class="series-name">{series.name}</h3>
                <p class="series-desc">{series.description}</p>
                <div class="series-footer">
                  <span class="series-count">{series.count}편</span>
                  <span class="series-range">{series.rangeLabel}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
  </div>
</BaseLayout>
