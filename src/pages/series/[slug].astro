---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SERIES_META, seriesSlug, formatShortDate, formatYearMonth, readingTime } from '../../lib/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const seriesSet = new Set<string>();
  posts.forEach(post => { if (post.data.series) seriesSet.add(post.data.series); });

  return Array.from(seriesSet).map(seriesName => ({
    params: { slug: seriesSlug(seriesName) },
    props: { seriesName }
  }));
}

const { seriesName } = Astro.props;

const meta = SERIES_META[seriesName] ?? { description: '시리즈 아티클 모음입니다.', slug: '', heroBg: 'linear-gradient(135deg,#1e293b,#334155)' };

// Fetch and sort posts belonging to this series ascending (chronological reading order)
const allPosts = await getCollection('blog', ({ data }) => !data.draft && data.series === seriesName);
const seriesPosts = allPosts.sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());

// Date range for hero footer
const minDate = seriesPosts[0]?.data.pubDate;
const maxDate = seriesPosts[seriesPosts.length - 1]?.data.pubDate;
const rangeLabel = minDate && maxDate ? `${formatYearMonth(minDate)} – ${formatYearMonth(maxDate)}` : '';
---

<BaseLayout title={seriesName} description={meta.description}>
  <div class="page-wrap series-page">
    <!-- Series Hero Banner -->
    <div class="series-hero" style={{ background: meta.heroBg }}>

      {/* ── 피카밈: purple/pink glows + dot grid ── */}
      {seriesName === '피카밈 개발기' && (
        <>
          <div style="position:absolute;right:-60px;top:-80px;width:320px;height:320px;background:radial-gradient(circle,rgba(196,77,255,0.11) 0%,transparent 65%);pointer-events:none;"></div>
          <div style="position:absolute;left:-40px;bottom:-80px;width:240px;height:240px;background:radial-gradient(circle,rgba(255,107,157,0.09) 0%,transparent 65%);pointer-events:none;"></div>
          <div style="position:absolute;inset:0;background-image:radial-gradient(circle,rgba(255,107,157,0.06) 1.2px,transparent 1.2px);background-size:24px 24px;pointer-events:none;"></div>
          <!-- 3 mini phone frames: home → loading → result -->
          <div class="series-hero-right" style="display:flex;gap:10px;align-items:center;">
            <!-- phone 1: home -->
            <div style="width:58px;height:102px;border-radius:14px;overflow:hidden;border:1.5px solid rgba(255,255,255,0.1);opacity:0.7;transform:translateY(8px) rotate(-4deg);background:#ffffff;">
              <div style="height:8px;background:#fff;border-bottom:1px solid #f0e8f5;"></div>
              <div style="background:#111;height:94px;padding:6px 4px;display:flex;flex-direction:column;gap:4px;align-items:center;justify-content:center;">
                <div style="font-size:8px;font-weight:900;color:white;letter-spacing:-0.02em;">PICK-A-<em style="color:#FF6B9D;font-style:italic;">MEME</em></div>
                <div style="display:flex;gap:3px;">
                  <div style="width:16px;height:20px;border-radius:4px;background:linear-gradient(135deg,#2d1b4e,#1a0d2e);font-size:9px;display:flex;align-items:center;justify-content:center;">🐱</div>
                  <div style="width:16px;height:20px;border-radius:4px;background:linear-gradient(135deg,#1a2d1a,#0d1f0d);font-size:9px;display:flex;align-items:center;justify-content:center;">🐶</div>
                  <div style="width:16px;height:20px;border-radius:4px;background:linear-gradient(135deg,#2d1a1a,#1a0d0d);font-size:9px;display:flex;align-items:center;justify-content:center;">🐻</div>
                </div>
                <div style="width:40px;height:10px;border-radius:5px;background:#111;border:1px solid #333;"></div>
                <div style="width:40px;height:10px;border-radius:5px;background:linear-gradient(135deg,#FF6B9D,#C44DFF);box-shadow:0 2px 6px rgba(255,107,157,0.4);"></div>
              </div>
            </div>
            <!-- phone 2: loading (featured, front) -->
            <div style="position:relative;width:66px;height:114px;border-radius:16px;background:#1a1010;overflow:hidden;border:1.5px solid rgba(255,107,157,0.35);box-shadow:0 10px 28px rgba(255,107,157,0.35);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;">
              <div style="position:absolute;width:66px;height:114px;background:radial-gradient(circle at 50% 40%,rgba(255,107,157,0.1) 0%,transparent 65%);"></div>
              <div style="width:38px;height:50px;border-radius:9px;background:linear-gradient(135deg,#FF6B9D,#C44DFF);display:flex;align-items:center;justify-content:center;font-size:22px;box-shadow:0 4px 14px rgba(255,107,157,0.55);position:relative;z-index:1;">🐱</div>
              <div style="font-size:7px;font-weight:700;color:rgba(255,255,255,0.5);letter-spacing:0.1em;position:relative;z-index:1;">두구두구...</div>
            </div>
            <!-- phone 3: result -->
            <div style="width:58px;height:102px;border-radius:14px;overflow:hidden;border:1.5px solid rgba(255,255,255,0.1);opacity:0.7;transform:translateY(8px) rotate(4deg);background:#fff;">
              <div style="height:8px;background:#fff;border-bottom:1px solid #f0e8f5;"></div>
              <div style="background:#fff;height:94px;padding:4px;display:flex;flex-direction:column;gap:3px;">
                <div style="flex:1;border-radius:6px;background:linear-gradient(135deg,#1e1040,#0d0820);display:flex;align-items:center;justify-content:center;font-size:20px;position:relative;">
                  <span>🐱</span>
                  <div style="position:absolute;bottom:4px;left:4px;right:4px;background:rgba(255,255,255,0.92);border-radius:4px;padding:2px 3px;text-align:center;">
                    <div style="font-size:5.5px;font-weight:900;color:#111;line-height:1.3;">야근 5일차의<br/>그 표정</div>
                  </div>
                </div>
                <div style="height:11px;background:linear-gradient(135deg,#FF6B9D,#C44DFF);border-radius:4px;display:flex;align-items:center;justify-content:center;">
                  <span style="font-size:5px;color:white;font-weight:900;letter-spacing:0.04em;">PICK-A-MEME</span>
                </div>
              </div>
            </div>
          </div>
        </>
      )}

      {/* ── Pet-Pass: paw watermark + glass panel ── */}
      {seriesName === 'Pet-Pass 개발기' && (
        <>
          <div style="position:absolute;right:20px;bottom:-30px;font-size:200px;opacity:0.07;transform:rotate(-10deg);pointer-events:none;user-select:none;" class="series-hero-right">🐾</div>
          <div class="series-hero-right" style="width:240px;background:rgba(255,255,255,0.18);border:1px solid rgba(255,255,255,0.28);border-radius:12px;padding:10px;overflow:hidden;">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px;padding-bottom:8px;border-bottom:1px solid rgba(255,255,255,0.2);">
              <span style="font-size:14px;">🐾</span>
              <span style="font-size:11px;font-weight:800;color:white;letter-spacing:0.01em;">Pet-Pass</span>
              <div style="margin-left:auto;display:flex;gap:4px;">
                <span style="font-size:9px;background:rgba(255,255,255,0.2);color:white;border-radius:4px;padding:2px 6px;font-weight:600;">전국</span>
                <span style="font-size:9px;background:rgba(255,255,255,0.15);color:rgba(255,255,255,0.8);border-radius:4px;padding:2px 6px;font-weight:600;">카페</span>
              </div>
            </div>
            <div style="background:rgba(255,255,255,0.22);border-radius:8px;padding:8px 10px;display:flex;align-items:center;gap:8px;border:1px solid rgba(255,255,255,0.25);margin-bottom:5px;">
              <span style="font-size:14px;">☕</span>
              <div>
                <div style="font-size:10px;font-weight:700;color:white;">스타벅스 강남점</div>
                <div style="font-size:8px;color:rgba(255,255,255,0.6);">카페 · 23m</div>
              </div>
              <span style="margin-left:auto;font-size:9px;background:rgba(46,125,50,0.4);color:#a5d6a7;border-radius:4px;padding:2px 7px;font-weight:700;border:1px solid rgba(165,214,167,0.3);">✓</span>
            </div>
            <div style="background:rgba(255,255,255,0.16);border-radius:8px;padding:8px 10px;display:flex;align-items:center;gap:8px;border:1px solid rgba(255,255,255,0.18);margin-bottom:5px;">
              <span style="font-size:14px;">🍽</span>
              <div>
                <div style="font-size:10px;font-weight:700;color:rgba(255,255,255,0.88);">브런치 카페 소풍</div>
                <div style="font-size:8px;color:rgba(255,255,255,0.5);">음식점 · 87m</div>
              </div>
              <span style="margin-left:auto;font-size:9px;background:rgba(46,125,50,0.35);color:#a5d6a7;border-radius:4px;padding:2px 7px;font-weight:700;">✓</span>
            </div>
            <div style="background:rgba(255,255,255,0.10);border-radius:8px;padding:8px 10px;display:flex;align-items:center;gap:8px;border:1px solid rgba(255,255,255,0.12);">
              <span style="font-size:14px;">🌿</span>
              <div>
                <div style="font-size:10px;font-weight:700;color:rgba(255,255,255,0.72);">반려견과 함께 제과점</div>
                <div style="font-size:8px;color:rgba(255,255,255,0.4);">제과점 · 130m</div>
              </div>
              <span style="margin-left:auto;font-size:9px;background:rgba(46,125,50,0.25);color:#a5d6a7;border-radius:4px;padding:2px 7px;font-weight:700;opacity:0.7;">✓</span>
            </div>
          </div>
        </>
      )}

      {/* ── Redis: grid pattern + CACHE glyph ── */}
      {seriesName === 'Redis 프로젝트 회고' && (
        <>
          <div class="hero-pat" style="background-image:linear-gradient(rgba(255,255,255,0.08) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.08) 1px,transparent 1px);background-size:24px 24px;"></div>
          <div class="hero-glyph" style="font-size:108px;">CACHE</div>
        </>
      )}

      {/* ── live-study: dots + Java glyph ── */}
      {seriesName === '백기선 live-study (2020)' && (
        <>
          <div class="hero-pat" style="background-image:radial-gradient(circle,rgba(255,255,255,0.14) 1.4px,transparent 1.4px);background-size:22px 22px;"></div>
          <div class="hero-glyph" style="font-size:108px;">Java</div>
        </>
      )}

      <div class="series-hero-veil"></div>
      <div class="series-hero-inner">
        <div class="series-hero-label">아티클 시리즈</div>
        <h1 class="series-hero-title">{seriesName}</h1>
        <p class="series-hero-desc">{meta.description}</p>
        <div class="series-hero-foot">
          <span class="series-hero-pill">총 {seriesPosts.length}편</span>
          {rangeLabel && <span class="series-hero-range">{rangeLabel}</span>}
        </div>
      </div>
    </div>

    <!-- Count Divider -->
    <div class="section-header">
      <span class="section-title">총 {seriesPosts.length}편</span>
    </div>

    <!-- Timeline of Posts -->
    <div class="series-posts-timeline">
      {seriesPosts.map((post, index) => {
        const postReadingTime = readingTime(post.body || '');
        return (
          <a
            href={post.data.externalUrl ?? `/blog/${post.slug}`}
            class="timeline-item"
            target={post.data.externalUrl ? '_blank' : undefined}
            rel={post.data.externalUrl ? 'noopener noreferrer' : undefined}
          >
            <span class="timeline-num">{String(index + 1).padStart(2, '0')}</span>
            <div class="timeline-body">
              <div class="timeline-title">{post.data.title}</div>
              <p class="timeline-desc">{post.data.description}</p>
              <div class="timeline-meta">
                <span class="timeline-date">{formatShortDate(post.data.pubDate)}</span>
                <span class="timeline-date">· {postReadingTime}분 읽기</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>
