---
import { SITE_TITLE, NAV_LINKS } from '../consts';

const { pathname } = Astro.url;
---

<header>
  <nav>
    <a href="/" class="site-title">{SITE_TITLE}</a>
    <ul>
      {NAV_LINKS.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class:list={[{ active: pathname === href || (href !== '/' && pathname.startsWith(href)) }]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  header {
    border-bottom: 1px solid var(--color-border);
    padding: 0 1.5rem;
  }

  nav {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    gap: 2rem;
  }

  .site-title {
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-text);
    font-family: var(--font-mono);
    flex-shrink: 0;
  }

  .site-title:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 1.5rem;
  }

  ul a {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    transition: color 0.15s;
  }

  ul a:hover,
  ul a.active {
    color: var(--color-text);
    text-decoration: none;
  }
</style>
