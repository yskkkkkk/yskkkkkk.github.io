---
const { pathname } = Astro.url;

// Helper to check if a link is active
const isActive = (path: string) => {
  if (path === '/') {
    return pathname === '/';
  }
  return pathname.startsWith(path);
};
---

<nav class="blog-nav" id="blog-nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">yskkkkkk.dev</a>
    <div class="nav-links">
      <a href="/blog" class:list={["nav-link", { active: isActive('/blog') }]}>블로그</a>
      <a href="/series" class:list={["nav-link", { active: isActive('/series') }]}>시리즈</a>
      <a href="/about" class:list={["nav-link", { active: isActive('/about') }]}>소개</a>
    </div>
    
    <div class="nav-actions">
      <button class="search-btn" id="nav-search-btn" title="검색 (⌘K)">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <circle cx="6.5" cy="6.5" r="4.5" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
        <span class="search-btn-label">검색</span>
        <kbd>⌘K</kbd>
      </button>
      
      <button class="theme-toggle" id="theme-toggle" aria-label="테마 전환">
        <span class="toggle-track">
          <span class="toggle-thumb" id="theme-toggle-thumb"></span>
        </span>
        <span class="toggle-icon" aria-hidden="true">
          <svg class="icon-sun" width="14" height="14" viewBox="0 0 16 16" fill="none">
            <circle cx="8" cy="8" r="3.4" stroke="currentColor" stroke-width="1.4"></circle>
            <path d="M8 1.6V3.1M8 12.9V14.4M1.6 8H3.1M12.9 8H14.4M3.5 3.5L4.6 4.6M11.4 11.4L12.5 12.5M3.5 12.5L4.6 11.4M11.4 4.6L12.5 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
          </svg>
          <svg class="icon-moon" width="14" height="14" viewBox="0 0 16 16" fill="none">
            <path d="M13.7 9.9A6 6 0 1 1 6.1 2.3a6.7 6.7 0 0 0 7.6 7.6Z" fill="currentColor"></path>
          </svg>
        </span>
      </button>
    </div>
  </div>
</nav>

<script is:inline>
  // Sticky scroll border effect
  const nav = document.getElementById('blog-nav');
  if (nav) {
    const handleScroll = () => {
      if (window.scrollY > 8) {
        nav.classList.add('scrolled');
      } else {
        nav.classList.remove('scrolled');
      }
    };
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll(); // Run once on load
  }

  // Theme toggle functionality (icon visibility is driven by [data-theme] in CSS)
  const themeToggle = document.getElementById('theme-toggle');

  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const activeTheme = document.documentElement.getAttribute('data-theme') || 'light';
      const nextTheme = activeTheme === 'light' ? 'dark' : 'light';

      document.documentElement.setAttribute('data-theme', nextTheme);
      localStorage.setItem('theme', nextTheme);
    });
  }

  // Search button event trigger
  const navSearchBtn = document.getElementById('nav-search-btn');
  if (navSearchBtn) {
    navSearchBtn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-search-modal'));
    });
  }
</script>
