---
import { SITE_TITLE, AUTHOR } from '../consts';

const year = new Date().getFullYear();
---

<footer>
  <p>
    &copy; {year} {AUTHOR} &mdash; Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>
  </p>
</footer>

<style>
  footer {
    border-top: 1px solid var(--color-border);
    padding: 1.5rem;
    text-align: center;
  }

  p {
    max-width: var(--max-width);
    margin: 0 auto;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
</style>
