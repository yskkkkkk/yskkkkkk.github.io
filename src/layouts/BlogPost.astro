---
import BaseLayout from './BaseLayout.astro';
import { getCollection } from 'astro:content';
import { seriesSlug as toSeriesSlug } from '../lib/utils';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags?: string[];
  headings?: { depth: number; slug: string; text: string }[];
  slug?: string;
  series?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags = [],
  headings = [],
  slug = '',
  series
} = Astro.props;

// Format date helper
const formatDate = (date: Date) => {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, '0');
  const d = String(date.getDate()).padStart(2, '0');
  return `${y}.${m}.${d}`;
};

// Fetch specific post body to estimate reading time
const allPosts = await getCollection('blog');
const currentPost = allPosts.find(p => p.slug === slug);
const postBody = currentPost?.body || '';

const calculateReadingTime = (body: string) => {
  const cleanText = body.trim().replace(/[#*`_\[\]()\-]/g, '');
  const words = cleanText.split(/\s+/).length;
  return Math.ceil(words / 180) || 3;
};

const readingTime = calculateReadingTime(postBody);

// Retrieve posts in same series
let seriesPosts: { title: string; slug: string; order: number; externalUrl?: string }[] = [];
if (series) {
  seriesPosts = allPosts
    .filter(p => !p.data.draft && p.data.series === series)
    .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf())
    .map((p, idx) => ({
      title: p.data.title,
      slug: p.slug,
      order: idx + 1,
      externalUrl: p.data.externalUrl,
    }));
}

const seriesSlug = series ? toSeriesSlug(series) : '';
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={title} description={description}>
  <!-- Reading Progress Bar -->
  <div class="reading-progress" id="reading-progress-bar"></div>

  <div class="page-wrap post-page">
    <!-- Breadcrumbs -->
    <nav class="breadcrumb">
      <a href="/">홈</a>
      <span>›</span>
      <a href="/blog">블로그</a>
      {series && (
        <span>›</span>
        <a href={`/series/${seriesSlug}`}>{series}</a>
      )}
    </nav>

    <!-- 2-Column Responsive Layout -->
    <div class="post-layout">
      <!-- Main Content Area -->
      <article class="post-main">
        <header>
          <h1 class="post-headline">{title}</h1>
          <div class="post-meta">
            <span class="meta-date">{formatDate(pubDate)}</span>
            <span class="meta-read">{readingTime}분 읽기</span>
            {series && (
              <a href={`/series/${seriesSlug}`} class="meta-series-btn">{series}</a>
            )}
            <div class="meta-tags">
              {tags.map(tag => (
                <span class="tag-chip">{tag}</span>
              ))}
            </div>
          </div>
        </header>

        {heroImage && (
          <img src={heroImage} alt={title} style="width:100%; margin-bottom:32px; border:1px solid var(--border);" />
        )}

        <!-- Main Body Wrapper -->
        <div class="post-content" id="post-content-container">
          <slot />
        </div>

        <!-- Bottom Series Navigation Bar -->
        {seriesPosts.length > 0 && (
          <div class="series-nav-bar">
            <span class="series-nav-label">시리즈</span>
            <a href={`/series/${seriesSlug}`} class="series-nav-title">{series}</a>
            <div class="series-posts-list">
              {seriesPosts.map(sp => (
                <a
                  href={sp.externalUrl ?? `/blog/${sp.slug}`}
                  target={sp.externalUrl ? '_blank' : undefined}
                  rel={sp.externalUrl ? 'noopener noreferrer' : undefined}
                  class:list={["series-post-item", { current: sp.slug === slug }]}
                >
                  <span class="series-post-order">{String(sp.order).padStart(2, '0')}</span>
                  <span>{sp.title}</span>
                </a>
              ))}
            </div>
          </div>
        )}
      </article>

      <!-- TOC Sticky Sidebar (Hidden on mobile) -->
      {tocHeadings.length > 0 && (
        <aside>
          <nav class="toc" id="toc-sidebar">
            <div class="toc-title">목차</div>
            {tocHeadings.map(h => (
              <button class:list={["toc-item", `h${h.depth}`]} data-id={h.slug}>
                {h.text}
              </button>
            ))}
          </nav>
        </aside>
      )}
    </div>
  </div>
</BaseLayout>

<!-- Client Side TOC, Progress, Hash Syncing Script -->
<script is:inline>
  (function() {
    // 1. Reading Progress Bar Controller
    const progressBar = document.getElementById('reading-progress-bar');
    if (progressBar) {
      const handleProgress = () => {
        const el = document.documentElement;
        const scrolled = el.scrollTop;
        const total = el.scrollHeight - el.clientHeight;
        const pct = total > 0 ? Math.min(100, (scrolled / total) * 100) : 0;
        progressBar.style.width = pct + '%';
      };
      window.addEventListener('scroll', handleProgress, { passive: true });
      handleProgress(); // Initial run
    }

    // 2. TOC Highlighting & Scrolling & URL Hash syncing
    const tocSidebar = document.getElementById('toc-sidebar');
    if (tocSidebar) {
      const tocItems = tocSidebar.querySelectorAll('.toc-item');
      const headingElements = Array.from(tocItems).map(item => {
        const id = item.getAttribute('data-id');
        return document.getElementById(id);
      }).filter(Boolean);

      if (headingElements.length > 0) {
        // Highlighting active heading using IntersectionObserver
        let activeId = '';
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              activeId = e.target.id;
              updateActiveTOC();
            }
          });
        }, { rootMargin: '-20% 0px -70% 0px' });

        headingElements.forEach(el => observer.observe(el));

        const updateActiveTOC = () => {
          tocItems.forEach(item => {
            if (item.getAttribute('data-id') === activeId) {
              item.classList.add('active');
            } else {
              item.classList.remove('active');
            }
          });
        };

        // Click handler for smooth scrolling to headings (offset 84px)
        tocItems.forEach(item => {
          item.addEventListener('click', (e) => {
            e.preventDefault();
            const id = item.getAttribute('data-id');
            const targetEl = document.getElementById(id);
            if (targetEl) {
              const top = targetEl.getBoundingClientRect().top + window.pageYOffset - 84;
              window.scrollTo({ top, behavior: 'smooth' });
              
              // Direct URL Hash update immediately on click
              history.replaceState(null, '', '#' + id);
            }
          });
        });

        // Debounced scroll hash synchronizer (350ms)
        let hashSyncTimer;
        const handleHashSync = () => {
          clearTimeout(hashSyncTimer);
          hashSyncTimer = setTimeout(() => {
            let topmostHeading = '';
            headingElements.forEach(h => {
              const rect = h.getBoundingClientRect();
              if (rect.top < 120) {
                topmostHeading = h.id;
              }
            });
            if (topmostHeading) {
              history.replaceState(null, '', '#' + topmostHeading);
            }
          }, 350);
        };
        window.addEventListener('scroll', handleHashSync, { passive: true });

        // Scroll to heading on initial mount if hash is present
        if (window.location.hash) {
          const hashId = window.location.hash.replace('#', '');
          const targetEl = document.getElementById(hashId);
          if (targetEl) {
            setTimeout(() => {
              const top = targetEl.getBoundingClientRect().top + window.pageYOffset - 84;
              window.scrollTo({ top });
              activeId = hashId;
              updateActiveTOC();
            }, 150);
          }
        }
      }
    }
  })();
</script>
