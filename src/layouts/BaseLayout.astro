---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: {
    pubDate: Date;
    updatedDate?: Date;
    tags?: string[];
  };
}

const { title, description, image, article } = Astro.props;

// Fetch all non-draft posts for search index
const allPosts = await getCollection('blog', ({ data }) => !data.draft && !data.externalUrl);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Helper to format date exactly like ko-KR 'YYYY.MM.DD'
const formatDate = (date: Date) => {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, '0');
  const d = String(date.getDate()).padStart(2, '0');
  return `${y}.${m}.${d}`;
};

// Build light search index payload
const searchIndex = sortedPosts.map(post => ({
  slug: `/blog/${post.slug}`,
  title: post.data.title,
  description: post.data.description,
  series: post.data.series || '',
  tags: post.data.tags || [],
  dateLabel: formatDate(post.data.pubDate)
}));
---

<!doctype html>
<html lang="ko" data-theme="light">
  <head>
    <BaseHead title={title} description={description} image={image} article={article} />
  </head>
  <body>
    <Header />
    <div class="page-fade">
      <main style="flex: 1; width: 100%;">
        <slot />
      </main>
      <Footer />
    </div>

    <!-- Cmd+K Search Modal Markup -->
    <div class="search-overlay" id="search-overlay" style="display: none;">
      <div class="search-modal" id="search-modal">
        <div class="search-input-wrap">
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none">
            <circle cx="6.5" cy="6.5" r="4.5" stroke="currentColor" stroke-width="1.5"></circle>
            <path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
          </svg>
          <input class="search-input" id="search-input" placeholder="포스트 검색..." autocomplete="off"/>
          <kbd class="search-esc">ESC</kbd>
        </div>
        <div class="search-results" id="search-results">
          <!-- Dynamic search results populated by client script -->
        </div>
        <div class="search-hint">
          <span class="search-hint-item"><kbd>↑</kbd><kbd>↓</kbd> 이동</span>
          <span class="search-hint-item"><kbd>↵</kbd> 열기</span>
          <span class="search-hint-item"><kbd>ESC</kbd> 닫기</span>
        </div>
      </div>
    </div>

    <!-- Search Index Injection -->
    <script is:inline define:vars={{ searchIndex }}>
      window.SEARCH_INDEX = searchIndex;
    </script>

    <!-- Global Client Search & Modal Controller Script -->
    <script is:inline>
      (function() {
        const overlay = document.getElementById('search-overlay');
        const input = document.getElementById('search-input');
        const resultsContainer = document.getElementById('search-results');
        
        let focusedIndex = 0;
        let currentResults = [];

        // Toggle modal open/close
        const openModal = () => {
          overlay.style.display = 'flex';
          input.focus();
          renderResults();
        };

        const closeModal = () => {
          overlay.style.display = 'none';
          input.value = '';
          focusedIndex = 0;
        };

        // Listen for internal trigger from header search button
        window.addEventListener('open-search-modal', openModal);

        // Listen for keyboard shortcuts (Cmd+K / Ctrl+K and Esc)
        window.addEventListener('keydown', (e) => {
          if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
            e.preventDefault();
            if (overlay.style.display === 'none') {
              openModal();
            } else {
              closeModal();
            }
          }

          if (overlay.style.display === 'flex') {
            if (e.key === 'Escape') {
              closeModal();
            }
            if (e.key === 'ArrowDown') {
              e.preventDefault();
              focusedIndex = Math.min(focusedIndex + 1, currentResults.length - 1);
              updateFocusedUI();
            }
            if (e.key === 'ArrowUp') {
              e.preventDefault();
              focusedIndex = Math.max(focusedIndex - 1, 0);
              updateFocusedUI();
            }
            if (e.key === 'Enter') {
              e.preventDefault();
              if (currentResults[focusedIndex]) {
                window.location.href = currentResults[focusedIndex].slug;
                closeModal();
              }
            }
          }
        });

        // Close on overlay background click
        overlay.addEventListener('click', (e) => {
          if (e.target === overlay) {
            closeModal();
          }
        });

        // Search algorithm & highlight helper
        const escapeRegex = (str) => str.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&');
        
        const highlightText = (text, query) => {
          if (!query.trim()) return text;
          try {
            const regex = new RegExp(`(${escapeRegex(query)})`, 'gi');
            return text.replace(regex, '<mark>$1</mark>');
          } catch(e) {
            return text;
          }
        };

        // Render search results
        const renderResults = () => {
          const query = input.value.toLowerCase().trim();
          const index = window.SEARCH_INDEX || [];
          
          if (!query) {
            // Default show 6 most recent posts
            currentResults = index.slice(0, 6);
          } else {
            // Filter list matching title, description, tags, or series
            currentResults = index.filter(p => {
              return p.title.toLowerCase().includes(query) ||
                     p.description.toLowerCase().includes(query) ||
                     p.series.toLowerCase().includes(query) ||
                     p.tags.some(t => t.toLowerCase().includes(query));
            });
          }

          // Reset focus index
          focusedIndex = 0;

          if (currentResults.length === 0) {
            resultsContainer.innerHTML = `<div class="search-empty">"${input.value}"에 대한 결과가 없습니다.</div>`;
            return;
          }

          resultsContainer.innerHTML = currentResults.map((p, i) => {
            const highlightedTitle = highlightText(p.title, query);
            const seriesTag = p.series ? `<span class="result-series">${p.series}</span>` : '';
            const tagsJoined = p.tags.slice(0, 3).join(' · ');
            const tagSpan = tagsJoined ? `<span class="result-tags">${tagsJoined}</span>` : '';
            
            return `
              <button class="search-result-item ${i === 0 ? 'focused' : ''}" 
                      data-index="${i}" 
                      onclick="window.location.href='${p.slug}'"
                      onmouseenter="window.dispatchEvent(new CustomEvent('search-focus', {detail: ${i}}))">
                <span class="result-title">${highlightedTitle}</span>
                <div class="result-meta">
                  ${seriesTag}
                  ${tagSpan}
                  <span class="result-date">${p.dateLabel}</span>
                </div>
              </button>
            `;
          }).join('');
        };

        // Wire mouse-hover focus event
        window.addEventListener('search-focus', (e) => {
          focusedIndex = e.detail;
          updateFocusedUI();
        });

        // Update focused element visual class
        const updateFocusedUI = () => {
          const items = resultsContainer.querySelectorAll('.search-result-item');
          items.forEach((item, i) => {
            if (i === focusedIndex) {
              item.classList.add('focused');
              // Ensure focused item is scrolled into view in scroll container
              item.scrollIntoView({ block: 'nearest' });
            } else {
              item.classList.remove('focused');
            }
          });
        };

        // Bind input typing event
        input.addEventListener('input', renderResults);
      })();
    </script>
  </body>
</html>
